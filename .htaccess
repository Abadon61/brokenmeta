ErrorDocument 404 /404.html

# Old manual-input DPS calculator, replaced 2026-09-26 by the export-based simulation page.
Redirect 301 /wow-forever/simulateur/ /wow-forever/simuler-mon-personnage/
RedirectMatch 301 ^/assets/downloads/BrokenMeta-.*\.zip$ https://www.curseforge.com/wow/addons/broken-meta-hub
Redirect 301 /en/wow-forever/simulateur/ /en/wow-forever/simuler-mon-personnage/
# TFT overview moved from / to /tft/ on 2026-10-03: its tier pages follow.
RedirectMatch 301 ^/tier/([a-z]+)/$ /tft/tier/$1/
RedirectMatch 301 ^/en/tier/([a-z]+)/$ /en/tft/tier/$1/

# WoW: Forever guides hub / class overview pages removed 2026-10-02.
RedirectMatch 301 ^/wow-forever/guides/$ /wow-forever/
RedirectMatch 301 ^/wow-forever/guides/druid/$ /wow-forever/guides/druid/balance/
RedirectMatch 301 ^/wow-forever/guides/hunter/$ /wow-forever/guides/hunter/beast-mastery/
RedirectMatch 301 ^/wow-forever/guides/mage/$ /wow-forever/guides/mage/arcane/
RedirectMatch 301 ^/wow-forever/guides/paladin/$ /wow-forever/guides/paladin/holy/
RedirectMatch 301 ^/wow-forever/guides/priest/$ /wow-forever/guides/priest/discipline/
RedirectMatch 301 ^/wow-forever/guides/rogue/$ /wow-forever/guides/rogue/assassination/
RedirectMatch 301 ^/wow-forever/guides/shaman/$ /wow-forever/guides/shaman/elemental/
RedirectMatch 301 ^/wow-forever/guides/warlock/$ /wow-forever/guides/warlock/affliction/
RedirectMatch 301 ^/wow-forever/guides/warrior/$ /wow-forever/guides/warrior/arms/
RedirectMatch 301 ^/en/wow-forever/guides/$ /en/wow-forever/
RedirectMatch 301 ^/en/wow-forever/guides/druid/$ /en/wow-forever/guides/druid/balance/
RedirectMatch 301 ^/en/wow-forever/guides/hunter/$ /en/wow-forever/guides/hunter/beast-mastery/
RedirectMatch 301 ^/en/wow-forever/guides/mage/$ /en/wow-forever/guides/mage/arcane/
RedirectMatch 301 ^/en/wow-forever/guides/paladin/$ /en/wow-forever/guides/paladin/holy/
RedirectMatch 301 ^/en/wow-forever/guides/priest/$ /en/wow-forever/guides/priest/discipline/
RedirectMatch 301 ^/en/wow-forever/guides/rogue/$ /en/wow-forever/guides/rogue/assassination/
RedirectMatch 301 ^/en/wow-forever/guides/shaman/$ /en/wow-forever/guides/shaman/elemental/
RedirectMatch 301 ^/en/wow-forever/guides/warlock/$ /en/wow-forever/guides/warlock/affliction/
RedirectMatch 301 ^/en/wow-forever/guides/warrior/$ /en/wow-forever/guides/warrior/arms/


<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
