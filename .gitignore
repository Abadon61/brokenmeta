.env
__pycache__/
*.pyc
.venv/
data/raw/
data/raw_lol/
data/output/*.json
!data/output/.gitkeep

# Generated static site (rebuilt from data/output/*.json via
# site_build/build_site.py) -- binary images + ~35MB, not source.
site_build/dist/
site_build/*.zip
*.zip

# Local runtime state, not source.
.claude/scheduled_tasks.lock

# Exported social cards (social_content/build_digest.py + card_*.html) --
# generated PNGs, not source, regenerate on demand via the tool itself.
social_content/out/

# WoW: Forever talent importer: raw client tables (Blizzard data, re-downloadable) and unapproved staging output
data/wow_talents_raw/
data/wow_talents_staging/

# graphify output (regenerate with: graphify update .)
graphify-out/
